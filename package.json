{
  "name": "@nexdom/pkg-template",
  "version": "0.0.0",
  "private": true,
  "description": "A template for creating NEXDOM flavor Node.js libraries.",
  "keywords": [
    "lib",
    "nexdom",
    "typescript",
    "utils"
  ],
  "homepage": "https://nexdom-healthtech.github.io/pkg-template/",
  "bugs": {
    "url": "https://github.com/nexdom-healthtech/pkg-template/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@nexdom.tec.br>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexdom-healthtech/pkg-template.git",
    "home": "https://github.com/nexdom-healthtech/pkg-template#readme"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vpr build",
    "prepare": "vp config",
    "depcruise": "depcruise src --output-type err-long",
    "depcruise:graph": "depcruise src --output-type dot| dot -T svg > dependencygraph.svg",
    "depcruise:graph:no-tests": "depcruise src --exclude \"__tests__\"  --output-type dot | dot -T svg > dependencygraph.no-tests.svg",
    "docs:dev": "vitepress dev docs --host"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260629.1",
    "@vitest/coverage-v8": "4.1.9",
    "bumpp": "^12.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^30.0.0",
    "oxc-minify": "^0.144.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.2",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vue": "^3.5.40"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "presetConfig": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@10.32.0"
}
